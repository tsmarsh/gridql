{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "outDir": "./lib",
    "rootDirs": ["./"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "lib"]
} 